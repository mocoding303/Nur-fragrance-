{%- liquid
  assign html_lang = request.locale.iso_code
  if request.path contains '/pages/arabian-perfume-samples-germany' or request.path contains '/pages/arabische-parfuemproben' or request.path contains '/pages/lattafa-samples' or request.path contains '/blogs/journal/what-is-a-perfume-decant' or request.path contains '/blogs/journal/which-perfume-sample-size-should-you-choose' or request.path contains '/blogs/journal/best-arabic-perfumes-for-beginners' or request.path contains '/blogs/journal/best-oud-perfume-samples-for-beginners'
    assign html_lang = 'de'
  endif

  assign nur_de = false
  if html_lang == 'de'
    assign nur_de = true
  endif

  assign seo_title = page_title
  assign seo_description = page_description

  comment
    Titles below are theme-controlled, not admin SEO fields. German strings were
    added without language branching, so the English root URLs served German
    titles and metas — and / and /de ended up byte-identical, which risks Google
    consolidating the pair instead of treating it as a language pair.
    Branched on nur_de 2026-08-26. English copy mirrors the German hedging
    ("currently available", "before buying more") — no added claims.
    NOTE: pages/articles listed in the html_lang override at the top of this file
    are deliberately German-only on root URLs; they are intentionally not branched.
  endcomment
  if request.page_type == 'index'
    if nur_de
      assign seo_title = 'Arabische Parfumproben & Decants in Deutschland | NUR'
      assign seo_description = 'Teste verfügbare arabische Düfte als kleinere Probe oder Discovery Set. Vergleiche Decants, Probengrößen und Marken, bevor du mehr Duft kaufst.'
    else
      assign seo_title = 'Arabian Perfume Samples & Decants in Germany | NUR'
      assign seo_description = 'Try available Arabian fragrances as a smaller sample or discovery set. Compare decants, sample sizes and brands before buying more.'
    endif
  elsif request.page_type == 'collection'
    case collection.handle
      when 'arabic-perfumes'
        assign seo_title = 'Arabic Perfumes in Germany & Europe | NUR Fragrances'
        assign seo_description = 'Discover authentic Arabic perfumes and fragrance samples from Lattafa, Armaf, Swiss Arabian and more. Hand-filled in Germany with tracked European shipping.'
      when 'oud-perfumes'
        assign seo_title = 'Oud Perfumes & Oud Samples in Europe | NUR Fragrances'
        assign seo_description = 'Explore oud perfume samples with smoky woods, amber, leather and rose profiles. Try authentic oriental decants before buying a full bottle.'
      when 'musk-perfumes'
        assign seo_title = 'Musk Perfumes & Clean Arabian Samples | NUR Fragrances'
        assign seo_description = 'Shop musk perfume samples with clean, soft and sensual Arabian scent profiles. Shipped tracked from Germany across Europe.'
      when 'bakhoor'
        assign seo_title = 'Bakhoor & Arabian Home Fragrance in Europe | NUR Fragrances'
        assign seo_description = 'Discover bakhoor-inspired Arabian fragrance profiles, warm woods, amber and incense notes for a rich oriental scent experience.'
      when 'perfume-oils'
        assign seo_title = 'Perfume Oils & Arabian Oil Fragrances | NUR Fragrances'
        assign seo_description = 'Explore concentrated perfume oils and oil-inspired Arabic scents with rich musk, amber, oud and floral profiles.'
      when 'best-arabic-fragrances-germany'
        assign seo_title = 'Best Arabic Fragrances in Germany | NUR Fragrances'
        assign seo_description = 'Find the best Arabic fragrances to try in Germany, from beginner-friendly Lattafa samples to fresh Armaf decants and luxury oriental scents.'
      when 'oriental-perfumes-europe'
        assign seo_title = 'Oriental Perfumes in Europe | Arabic Fragrance Samples'
        assign seo_description = 'Shop oriental perfume samples in Europe: oud, musk, amber, rose, sweet gourmand and fresh woody Arabic fragrances filled from original bottles.'
      when 'all'
        assign seo_title = 'Arabic Fragrance Samples, Oud & Oriental Perfumes | NUR'
        assign seo_description = 'Explore all NUR fragrance samples: authentic Arabic perfumes, oud, musk, amber, gourmand and fresh woody decants shipped tracked from Germany.'
      when 'gourmand-fragrance-samples'
        if nur_de
          assign seo_title = 'Gourmand-Parfumproben testen | NUR Fragrance'
          assign seo_description = 'Vergleiche aktuell verfügbare Gourmand-Duftproben in kleinen Größen und teste deine Auswahl auf der Haut, bevor du mehr davon kaufst.'
        else
          assign seo_title = 'Gourmand Perfume Samples & Decants | NUR'
          assign seo_description = 'Compare currently available gourmand fragrance samples in small sizes and test your picks on skin before buying more.'
        endif
      when 'fresh-office-safe-fragrance-samples'
        if nur_de
          assign seo_title = 'Frische Parfumproben fürs Büro testen | NUR'
          assign seo_description = 'Entdecke aktuell verfügbare frische und fürs Büro eingeordnete Duftproben. Teste Wirkung und Dosierung selbst vor einer größeren Menge.'
        else
          assign seo_title = 'Fresh & Office-Safe Perfume Samples | NUR'
          assign seo_description = 'Explore currently available fresh, office-friendly fragrance samples. Judge strength and dosage yourself before committing to more.'
        endif
      when 'oud-connoisseur-fragrance-samples'
        if nur_de
          assign seo_title = 'Oud-Parfumproben für Einsteiger & Kenner | NUR'
          assign seo_description = 'Vergleiche aktuell verfügbare Oud- und holzorientierte Duftproben. Starte klein und prüfe jedes Profil auf deiner eigenen Haut.'
        else
          assign seo_title = 'Oud Perfume Samples for Beginners & Fans | NUR'
          assign seo_description = 'Compare currently available oud and woody fragrance samples. Start small and judge each profile on your own skin.'
        endif
      when 'lattafa-perfume-samples'
        if nur_de
          assign seo_title = 'Lattafa-Proben in Deutschland bestellen | NUR'
          assign seo_description = 'Teste aktuell verfügbare Lattafa-Düfte als kleine Decants. Vergleiche Größen und Produktangaben, bevor du mehr Duft kaufst.'
        else
          assign seo_title = 'Lattafa Perfume Samples & Decants | NUR'
          assign seo_description = 'Try currently available Lattafa fragrances as small decants. Compare sizes and product details before buying more.'
        endif
      when 'bundle-builder-fragrances'
        if nur_de
          assign seo_title = 'Arabische Duftproben im Discovery Set | NUR'
          assign seo_description = 'Kombiniere aktuell verfügbare arabische Duftproben im Discovery Set und vergleiche mehrere Richtungen mit weniger Blindkauf-Risiko.'
        else
          assign seo_title = 'Build Your Arabian Discovery Set | NUR'
          assign seo_description = 'Combine currently available Arabian fragrance samples into a discovery set and compare several directions with less blind-buy risk.'
        endif
    endcase
  elsif request.page_type == 'page'
    case page.handle
      when 'arabic-perfumes'
        assign seo_title = 'Arabic Perfumes & Samples in Germany | NUR Fragrances'
        assign seo_description = 'Discover authentic Arabic perfumes as sample decants from original bottles. Shop oud, musk, amber, rose and gourmand scents shipped tracked from Germany.'
      when 'arabic-perfume-decants-europe'
        assign seo_title = 'Arabic Perfume Samples & Decants in Europe | NUR Fragrance'
        assign seo_description = 'Try Arabian perfume samples from Lattafa, Armaf and Swiss Arabian. Choose 1 ml, 2 ml, 5 ml or 10 ml decants, dispatched from Germany to supported European destinations.'
      when 'arabische-parfuemproben'
        assign seo_title = 'Arabische Parfumproben in Deutschland: Guide | NUR'
        assign seo_description = 'Der komplette Guide zu arabischen Duftproben, Decants, Probengrößen, Discovery Sets und Hauttests vor dem Kauf einer größeren Menge.'
      when 'lattafa-samples'
        assign seo_title = 'Lattafa-Proben in Deutschland kaufen | NUR Fragrance'
        assign seo_description = 'Teste verfügbare Lattafa-Düfte als 1 ml, 2 ml, 5 ml oder 10 ml Decant, bevor du mehr Duft oder einen ganzen Flakon kaufst.'
      when 'oud-perfumes'
        assign seo_title = 'Oud Perfumes & Arabic Oud Samples | NUR Fragrances'
        assign seo_description = 'Learn and shop oud perfume samples with smoky, woody, rose, amber and leather profiles. Try authentic Arabic decants before a full bottle.'
      when 'musk-perfumes'
        assign seo_title = 'Musk Perfumes & Soft Arabic Samples | NUR Fragrances'
        assign seo_description = 'Shop musk perfume samples with clean, powdery, floral and ambered Arabic scent profiles, filled in Germany and shipped tracked across Europe.'
      when 'bakhoor'
        assign seo_title = 'Bakhoor-Inspired Arabian Fragrances | NUR Fragrances'
        assign seo_description = 'Discover bakhoor-inspired perfume samples with oud, smoke, amber, resin, woods and spice for a warm oriental scent experience.'
      when 'perfume-oils'
        assign seo_title = 'Perfume Oils & Oil-Inspired Arabic Scents | NUR'
        assign seo_description = 'Explore perfume oils and oil-inspired Arabic fragrance samples with musk, amber, oud, rose and vanilla profiles.'
      when 'best-arabic-fragrances-germany'
        assign seo_title = 'Best Arabic Fragrances in Germany | NUR Fragrances'
        assign seo_description = 'Find beginner-friendly Arabic fragrance samples in Germany, from Lattafa and Armaf to oud, musk, amber and oriental discovery sets.'
      when 'oriental-perfumes-europe'
        assign seo_title = 'Oriental Perfumes in Europe | Arabic Fragrance Samples'
        assign seo_description = 'Shop oriental perfume samples in Europe with NUR: Arabic decants, oud, musk, amber, rose and gourmand scents shipped tracked from Germany.'
      when 'llms'
        assign seo_title = 'NUR Fragrances LLM Reference | Arabic Perfumes in Europe'
        assign seo_description = 'Structured reference for AI search engines about NUR Fragrances, Arabic perfume samples, oud, musk and tracked shipping from Germany.'
      when 'find-my-scent'
        assign seo_title = 'Find My Scent Quiz | Arabian Perfume Samples'
        assign seo_description = 'Take the 60-second NUR scent quiz and find beginner-friendly Arabian perfume samples based on sweetness, freshness, oud, occasion and intensity.'
    endcase
  elsif request.page_type == 'product' and seo_description == blank
    assign seo_description = product.title | append: ' von ' | append: product.vendor | append: ' als unabhängigen Duft-Decant testen. Verfügbare Größen und Produktangaben direkt auf der Produktseite prüfen.'
  elsif request.page_type == 'article'
    if article.handle contains 'what-is-a-perfume-decant'
      assign seo_title = 'Parfum-Decants: Bedeutung & Größen | NUR Fragrance'
      assign seo_description = 'Was ist ein Parfum-Decant? Erfahre, wie Abfüllungen funktionieren, wie 1 ml bis 10 ml sich unterscheiden und wie Proben Blindkäufe vermeiden helfen.'
    elsif article.handle contains 'which-perfume-sample-size-should-you-choose'
      assign seo_title = 'Welche Parfumprobe-Größe? 1–10 ml Guide | NUR'
      assign seo_description = 'Wähle 1 ml, 2 ml, 5 ml oder 10 ml nach deinem Testziel. Ein klarer Größenvergleich ohne pauschale Sprühzahlen.'
    elsif article.handle contains 'best-arabic-perfumes-for-beginners'
      assign seo_title = 'Arabische Düfte für Anfänger testen | NUR Guide'
      assign seo_description = 'So vergleichst du arabische Duftproben als Anfänger: Richtung wählen, kleine Größen testen und Blindkäufe mit einem klaren Testplan vermeiden.'
    elsif article.handle contains 'best-oud-perfume-samples-for-beginners'
      assign seo_title = 'Oud für Anfänger: Proben richtig testen | NUR'
      assign seo_description = 'Was Oud bedeutet, warum Oud-Düfte unterschiedlich wirken und wie Anfänger kleine Proben ohne Mythen oder Blindkauf vergleichen.'
    endif
    comment
      These three articles had titles of 63-70 chars in BOTH languages, cut
      mid-word in the SERP. Only the title is overridden — the registered
      meta_description translations still flow through page_description.
      Base text only: the length-aware suffix logic below adds the brand.
    endcomment
    if article.handle contains 'khamrah-vs-baccarat'
      if nur_de
        assign seo_title = 'Khamrah vs. Baccarat Rouge 540: Lohnt es sich?'
      else
        assign seo_title = 'Khamrah vs Baccarat Rouge 540: Is It Worth It?'
      endif
    elsif article.handle contains 'khamrah-vs-khamrah-qahwa'
      if nur_de
        assign seo_title = 'Khamrah vs. Khamrah Qahwa: Welche zuerst?'
      else
        assign seo_title = 'Khamrah vs Khamrah Qahwa: Which First?'
      endif
    elsif article.handle contains 'office-safe-arabian-perfume-samples'
      if nur_de
        assign seo_title = 'Bürotaugliche arabische Parfümproben'
      else
        assign seo_title = 'Office-Safe Arabian Perfume Samples'
      endif
    endif
    if seo_description == blank
      assign seo_description = article.excerpt_or_content | strip_html | truncate: 155
    endif
  endif

  if seo_title == blank
    assign seo_title = shop.name
  endif
  comment
    Google truncates around 60 characters. The brand suffix used to be appended
    unconditionally, pushing 12 titles to 62-87 chars and cutting several
    mid-word. Spend the remaining budget on brand only when it actually fits.
  endcomment
  assign document_title = seo_title
  unless seo_title contains 'NUR'
    assign seo_title_len = seo_title | size
    if seo_title_len <= 43
      assign document_title = seo_title | append: ' | NUR Fragrances'
    elsif seo_title_len <= 54
      assign document_title = seo_title | append: ' | NUR'
    endif
  endunless
  if seo_description == blank
    assign seo_description = 'Entdecke arabische und orientalische Duftproben bei NUR Fragrance. Vergleiche verfügbare Decants und Größen, bevor du mehr Duft kaufst.'
  endif
  comment
    Safety net. Where a page has no SEO description set in admin, Shopify falls
    back to dumping ~320 chars of raw page body — 37 pages were doing this, and
    Google truncates it anyway. Capping at 158 keeps the SERP snippet clean and
    predictable. Descriptions already written under the cap are untouched.
    This is not a substitute for real descriptions on the 13 products and 15
    articles affected; it just stops raw content sprawling into the snippet.
  endcomment
  assign seo_description = seo_description | strip_html | strip | truncate: 158, '…'
-%}
<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" href="{{ 'favicon-nur.svg' | asset_url }}" type="image/svg+xml">
  <link rel="shortcut icon" href="{{ 'favicon-nur.svg' | asset_url }}" type="image/svg+xml">
  <meta name="theme-color" content="#050403">
  <title>{{ document_title | escape }}</title>
  <meta name="description" content="{{ seo_description | escape }}">
  {%- liquid
    assign nur_hidden_product = false
    if request.page_type == 'product'
      if product.type == 'Add-on' or product.product_type == 'Add-on' or product.tags contains '_hidden'
        assign nur_hidden_product = true
      endif
    endif
  -%}
  {%- liquid
    comment
      Conditional robots, not a blanket value.

      noindex,FOLLOW - never noindex,nofollow - on surfaces that generate
      near-duplicate text: internal search results and tag-filtered collection
      URLs. The "follow" is deliberate. Those pages still link to real products
      and that equity should keep flowing; the previous hidden-product rule used
      nofollow and cut it off at the knees.

      Pagination is deliberately NOT noindexed, against the usual instinct and
      against the brief this was built from. Google's pagination guidance is that
      paginated pages should stay indexable with self-canonicals, because they
      are frequently the only crawl path to deeper products - noindexing them
      strands that inventory. With 6 collections and 16 products nothing here
      paginates today, so the correct choice is also the free one. Do not
      "fix" this to noindex.

      max-image-preview:large on every indexable page. For a fragrance catalogue
      the bottle shot is the click, and the default preview size discards it.
    endcomment
    assign nur_robots = 'index,follow,max-image-preview:large'
    if nur_hidden_product
      assign nur_robots = 'noindex,follow'
    elsif request.page_type == 'search'
      assign nur_robots = 'noindex,follow'
    elsif current_tags != blank
      assign nur_robots = 'noindex,follow'
    endif
  -%}
  <meta name="robots" content="{{ nur_robots }}">
  {%- comment -%}
    'arabian-perfume-samples-germany' used to carry noindex,follow AND a canonical
    pointing at 'arabische-parfuemproben'. Google's guidance is not to combine the
    two: they instruct opposite handling, and a noindexed page is a weak canonical
    target. The canonical alone consolidates the duplicate and preserves any link
    equity, so the noindex was removed 2026-08-26. Canonical is set further down.
  {%- endcomment -%}

  {%- liquid
    assign og_type = 'website'
    if request.page_type == 'product'
      assign og_type = 'product'
    elsif request.page_type == 'article'
      assign og_type = 'article'
    endif

    assign social_image_url = ''
    if request.page_type == 'product'
      if product.featured_image
        assign social_image_url = product.featured_image | image_url: width: 1200 | prepend: 'https:'
      endif
    elsif request.page_type == 'article'
      if article.image
        assign social_image_url = article.image | image_url: width: 1200 | prepend: 'https:'
      endif
    endif
    if social_image_url == blank
      if settings.share_image
        assign social_image_url = settings.share_image | image_url: width: 1200 | prepend: 'https:'
      endif
    endif
    assign twitter_handle = settings.social_twitter | default: settings.social_instagram | default: 'nurfragrances'
    assign twitter_handle = twitter_handle | remove: '@'
  -%}

  <!-- Open Graph -->
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:locale" content="{% if html_lang == 'de' %}de_DE{% else %}en_US{% endif %}">
  <meta property="og:title" content="{{ document_title | escape }}">
  <meta property="og:description" content="{{ seo_description | escape }}">
  {%- if social_image_url != blank -%}
  <meta property="og:image" content="{{ social_image_url }}">
  <meta property="og:image:secure_url" content="{{ social_image_url }}">
  {%- endif -%}
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:site_name" content="NUR Fragrances">
  {%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | replace: ',', '.' }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code | default: 'EUR' }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  {%- elsif request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  <meta property="article:author" content="{{ article.author | default: 'NUR Fragrances' | escape }}">
  {%- endif -%}

  <!-- Twitter -->
  <meta name="twitter:card" content="{% if social_image_url != blank %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:site" content="@{{ twitter_handle }}">
  <meta name="twitter:title" content="{{ document_title | escape }}">
  <meta name="twitter:description" content="{{ seo_description | escape }}">
  {%- if social_image_url != blank -%}
  <meta name="twitter:image" content="{{ social_image_url }}">
  {%- endif -%}

  <!-- Canonical -->
  {%- comment -%}
    Duplicate-page consolidation. These handles are near-identical copies of a
    primary page and were all independently indexable:
      llms-1                  (944w) vs llms                  (949w)
      build-your-own-bundle-1 (306w) vs build-your-own-bundle (612w)
      bundle-custom           (323w) vs build-your-own-bundle (612w)
    All three bundle pages even share the title "Build Your Own Bundle".
    A 301 would be stronger, but in Shopify a redirect does not fire while a
    page still occupies the handle — that needs the pages deleted, which is an
    owner decision. Canonical consolidation is non-destructive and reversible.
    routes.root_url keeps each language pointing at its own primary.
  {%- endcomment -%}
  {%- liquid
    assign nur_canonical_target = ''
    if request.page_type == 'page'
      case page.handle
        when 'arabian-perfume-samples-germany'
          assign nur_canonical_target = 'arabische-parfuemproben'
        when 'llms-1'
          assign nur_canonical_target = 'llms'
        when 'build-your-own-bundle-1'
          assign nur_canonical_target = 'build-your-own-bundle'
        when 'bundle-custom'
          assign nur_canonical_target = 'build-your-own-bundle'
      endcase
    endif
  -%}
  {%- if nur_canonical_target != blank -%}
  <link rel="canonical" href="{{ shop.url }}{{ routes.root_url | append: "/" | replace: "//", "/" }}pages/{{ nur_canonical_target }}">
  {%- else -%}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- endif -%}
  {%- comment -%}
    hreflang is already emitted by Shopify inside {{ content_for_header }}.
    This manual block duplicated every annotation — 6 tags where 3 are unique,
    on all 73 indexable URLs. Verified across homepage, product, collection,
    article and page templates before removal (2026-08-26). Do not re-add it.
  {%- endcomment -%}

  {% render 'organization-json-ld' %}
  {% render 'breadcrumbs-json-ld' %}

  <!-- Theme CSS -->
  {{ 'nur.css' | asset_url | stylesheet_tag }}
  {{ 'nur-chatbot.css' | asset_url | stylesheet_tag }}
  {%- if request.page_type == 'index' -%}
    {{ 'nur-home.css' | asset_url | stylesheet_tag }}
    {{ 'nur-bundle.css' | asset_url | stylesheet_tag }}
  {%- elsif request.page_type == 'product' -%}
    {{ 'nur-product.css' | asset_url | stylesheet_tag }}
  {%- elsif request.page_type == 'blog' or request.page_type == 'article' -%}
    {{ 'nur-article.css' | asset_url | stylesheet_tag }}
  {%- elsif request.path contains '/pages/build-your-own-bundle' -%}
    {{ 'nur-bundle.css' | asset_url | stylesheet_tag }}
  {%- elsif request.path contains '/pages/find-my-scent' -%}
    {{ 'nur-scent-quiz.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

	  <!-- CDN base URL — must be in <head> so section inline scripts can use it -->
	  {%- assign nur_base = 'nur.css' | asset_url | split: 'nur.css' | first -%}
	  <script>window.NUR_IMG = "{{ nur_base }}"; window.NUR_DE = {{ nur_de | json }};</script>
	  {%- liquid
	    assign nur_needs_products = false
	    if request.page_type == 'index' or request.page_type == 'product' or request.page_type == 'collection'
	      assign nur_needs_products = true
	    elsif request.path contains '/pages/build-your-own-bundle' or request.path contains '/pages/bundle-'
	      assign nur_needs_products = true
	    endif
	  -%}
	  {%- if nur_needs_products -%}
	  <script>
	    {%- assign nur_fragrance_handles = '|dahaab-safi|club-de-nuit-precieux|khamrah|yulali|club-de-nuit-intense|meydan|rose-01|kismet-angel|asad|royal-bleu|melodie|turath|' -%}
	    {%- assign nur_product_count = 0 -%}
	    window.NUR_PRODUCTS = [
      {%- for product in collections.all.products limit: 30 -%}
        {%- if product.type == 'Add-on' or product.product_type == 'Add-on' or product.tags contains '_hidden' -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign handle_token = product.handle | prepend: '|' | append: '|' -%}
        {%- if nur_fragrance_handles contains handle_token -%}
          {%- if nur_product_count > 0 -%},{%- endif -%}
          {% render 'nur-product-data-json', product: product %}
          {%- assign nur_product_count = nur_product_count | plus: 1 -%}
        {%- endif -%}
	      {%- endfor -%}
	    ];
	  </script>
	  {%- endif -%}

  {{ content_for_header }}
</head>
<body>
  {%- comment -%} German-IP language nudge: shows to German-speaking-country visitors currently on the English site {%- endcomment -%}
  {%- assign nur_de_countries = 'DE,AT,CH,LI' | split: ',' -%}
  {%- if request.locale.iso_code != 'de' and nur_de_countries contains localization.country.iso_code -%}
    {%- assign nur_de_url = request.path | prepend: '/de' -%}
    <div id="deLangNudge" class="de-lang-nudge" role="dialog" aria-label="Sprache wechseln">
      <span class="de-lang-flag" aria-hidden="true">&#x1F1E9;&#x1F1EA;</span>
      <span class="de-lang-txt">Diese Seite auf <strong>Deutsch</strong> ansehen?</span>
      <a class="de-lang-go" href="{{ nur_de_url }}">Auf Deutsch anzeigen</a>
      <button type="button" class="de-lang-x" aria-label="Schließen" onclick="nurDismissDeNudge()">&#x2715;</button>
