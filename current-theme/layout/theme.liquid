<!-- Tiered cart progress (overrides legacy ship bar; thresholds match live shipping + free-sample discount) -->
<style>
#cartShipBar{display:none;padding:.75rem 1.1rem;font-size:.72rem;line-height:1.45;border-bottom:1px solid rgba(201,168,76,.12)}
#cartShipBar.show{display:block}
#cartShipBar .csb-track{height:4px;background:rgba(201,168,76,.15);border-radius:3px;margin-top:.45rem;overflow:hidden}
#cartShipBar .csb-fill{height:100%;background:var(--gold,#c9a84c);transition:width .4s ease}
</style>
<script>
document.addEventListener('DOMContentLoaded',function(){
  var TIER_SAMPLE=25, TIER_SHIP={{ settings.free_shipping_de_threshold | default: 39 | json }};
  var NUR_DE={{ nur_de | json }};
  function eur(n){return '€'+n.toFixed(2).replace('.',',');}
  window.updateShipBar=function(){
    var bar=document.getElementById('cartShipBar');
    if(!bar) return;
    fetch('/cart.js').then(function(r){return r.json()}).then(function(sc){
      var t=(sc.total_price||0)/100;
      if(!sc.item_count){bar.classList.remove('show');bar.innerHTML='';return;}
      var msg,pct;
      if(t<TIER_SAMPLE){
        msg=NUR_DE?'Noch '+eur(TIER_SAMPLE-t)+' bis zur <strong>gratis 1-ml-Probe</strong> 🎁':'Add '+eur(TIER_SAMPLE-t)+' to unlock a <strong>free 1 ml sample</strong> 🎁';
        pct=t/TIER_SAMPLE*50;
      }else if(t<TIER_SHIP){
        msg=NUR_DE?'Gratis-Probe freigeschaltet ✓ — leg eine 1 ml-Probe in den Warenkorb. Noch '+eur(TIER_SHIP-t)+' bis zum <strong>Gratisversand</strong> (DE)':'Free sample unlocked ✓ — add any 1 ml to your cart. '+eur(TIER_SHIP-t)+' to <strong>free shipping</strong> (DE)';
        pct=50+(t-TIER_SAMPLE)/(TIER_SHIP-TIER_SAMPLE)*50;
      }else{
        msg=NUR_DE?'🎉 <strong>Gratisversand freigeschaltet</strong> — deine gratis 1 ml-Probe wird an der Kasse berücksichtigt':'🎉 <strong>Free shipping unlocked</strong> — your free 1 ml sample applies at checkout';
        pct=100;
      }
      bar.innerHTML='<div class="csb-text">'+msg+'</div><div class="csb-track"><div class="csb-fill" style="width:'+Math.min(100,pct)+'%"></div></div>';
      bar.classList.add('show');
    }).catch(function(){});
  };
  window.updateShipBar();
});
</script>

</body>
</html>
