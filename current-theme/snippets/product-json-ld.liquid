{% doc %}
Renders Product structured data for Shopify product detail pages.
@param {product} product - The product to describe.
@example
{% render 'product-json-ld', product: product %}
{% enddoc %}

{%- liquid
  assign currency_code = cart.currency.iso_code | default: 'EUR'
  assign product_description = product.description | strip_html | strip_newlines | strip | truncate: 5000
  capture fallback_primary_asset
    render 'nur-product-fallback-asset', product: product
  endcapture
  assign fallback_primary_asset = fallback_primary_asset | strip
  capture fallback_gallery_names
    render 'nur-product-fallback-gallery', product: product
  endcapture
  assign fallback_gallery_names = fallback_gallery_names | strip
  assign fallback_gallery = fallback_gallery_names | split: '|'
  comment
    Same rule as the gallery, cards and JSON payload: while the curated asset
    set is richer than the product's Shopify media, it is the source of truth.
    Without this, a product carrying a single uploaded image advertised one
    image to Google instead of the six to eight it actually has.
  endcomment
  capture curated_asset_flag
    render 'nur-product-use-assets', product: product
  endcapture
  assign curated_asset_flag = curated_asset_flag | strip
  assign force_bundle_image = false
  assign bundle_lookup = product.handle | append: ' ' | append: product.title | downcase
  if bundle_lookup contains 'arabian-introduction' or bundle_lookup contains 'arabian introduction' or bundle_lookup contains 'signature-masculine' or bundle_lookup contains 'signature masculine' or bundle_lookup contains 'oud-explorer' or bundle_lookup contains 'oud explorer'
    assign force_bundle_image = true
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  "@id": {{ canonical_url | append: '#product' | json }},
  "productGroupID": {{ product.id | prepend: 'shopify-' | json }},
  "variesBy": "https://schema.org/size",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "description": {{ product_description | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  }{% if product.images.size > 0 or fallback_gallery_names != blank or fallback_primary_asset != blank %},
	  "image": [
      {%- if force_bundle_image and fallback_primary_asset != blank -%}
        {{ fallback_primary_asset | asset_url | prepend: 'https:' | json }}
      {%- elsif product.images.size > 0 and curated_asset_flag == blank -%}
	      {%- for image in product.images limit: 10 -%}
	        {{ image | image_url: width: 1600 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
	      {%- endfor -%}
      {%- elsif fallback_gallery_names != blank -%}
	      {%- for fallback_asset in fallback_gallery limit: 10 -%}
	        {{ fallback_asset | asset_url | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
	      {%- endfor -%}
      {%- else -%}
        {{ fallback_primary_asset | asset_url | prepend: 'https:' | json }}
      {%- endif -%}
  ]{% endif %},
  "hasVariant": [
    {%- for variant in product.variants -%}
      {%- capture variant_url -%}{{ shop.url }}{{ product.url }}?variant={{ variant.id }}{%- endcapture -%}
      {
        "@type": "Product",
        "@id": {{ variant_url | append: '#product' | json }},
        "name": {{ product.title | append: ' — ' | append: variant.title | json }},
        "url": {{ variant_url | json }},
        "size": {{ variant.title | json }},
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
        "isVariantOf": {
          "@id": {{ canonical_url | append: '#product' | json }}
        }{% if variant.sku != blank %},
        "sku": {{ variant.sku | json }}{% endif %}{% if variant.image %},
        "image": {{ variant.image | image_url: width: 1600 | prepend: 'https:' | json }}{% elsif product.featured_image %},
        "image": {{ product.featured_image | image_url: width: 1600 | prepend: 'https:' | json }}{% endif %},
        "offers": {
          "@type": "Offer",
          "url": {{ variant_url | json }},
          "priceCurrency": {{ currency_code | json }},
          "price": {{ variant.price | money_without_currency | replace: ',', '.' | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "seller": {
            "@id": {{ shop.url | append: '#organization' | json }}
          }
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
