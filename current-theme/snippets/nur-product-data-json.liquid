{% doc %}
Renders the compact Shopify-backed product data used by NUR frontend interactions.
@param {product} product - The Shopify product to serialize.
@example
{% render 'nur-product-data-json', product: product %}
{% enddoc %}

{%- liquid
  assign handle = product.handle
  assign gender = product.metafields.custom.gender | default: 'unisex'
  assign tag = product.metafields.custom.scent_profile | default: 'sophisticate'
  assign badge = ''
  assign glow = '#4a7c59'
  assign notes_top = product.metafields.custom.top_notes | default: ''
  assign notes_heart = product.metafields.custom.heart_notes | default: ''
  assign notes_base = product.metafields.custom.base_notes | default: ''
  assign note_keys = product.metafields.custom.note_keys | default: ''
  assign occ = product.metafields.custom.occasion | default: 'everyday'
  assign lon = product.metafields.custom.longevity | default: 4
  assign proj = product.metafields.custom.projection | default: 3
  assign rrp = product.metafields.custom.rrp | default: ''
  assign fallback_asset = ''

  case handle
    when 'dahaab-safi'
      assign fallback_asset = 'dahaab-safi-7.jpg'
      assign gender = 'her'
      assign tag = 'gourmand'
      assign badge = 'bestseller'
      assign glow = '#c87941'
      assign notes_top = 'Date · Plum'
      assign notes_heart = 'Rose · Saffron'
      assign notes_base = 'Sandalwood · Vanilla'
      assign note_keys = 'rose|vanilla|sandalwood'
      assign occ = 'everyday'
      assign lon = 4
      assign proj = 3
      assign rrp = '€45'
    when 'club-de-nuit-precieux'
      assign fallback_asset = 'club-de-nuit-precieux-1.jpg'
      assign gender = 'unisex'
      assign tag = 'connoisseur'
      assign badge = 'bestseller'
      assign glow = '#8a3060'
      assign notes_top = 'Bergamot · Pepper'
      assign notes_heart = 'Iris · Jasmine'
      assign notes_base = 'Patchouli · Vetiver'
      assign note_keys = 'musk|woody'
      assign occ = 'evening'
      assign lon = 5
      assign proj = 5
      assign rrp = '€95'
    when 'khamrah'
      assign fallback_asset = 'khamrah-1.jpg'
      assign gender = 'unisex'
      assign tag = 'gourmand'
      assign badge = 'bestseller'
      assign glow = '#c87941'
      assign notes_top = 'Honey · Saffron'
      assign notes_heart = 'Oud · Rose'
      assign notes_base = 'Vanilla · Amber'
      assign note_keys = 'oud|rose|vanilla|amber'
      assign occ = 'datenight'
      assign lon = 5
      assign proj = 4
      assign rrp = '€50'
    when 'yulali'
      assign fallback_asset = 'yulali-1.jpg'
      assign gender = 'her'
      assign tag = 'sophisticate'
      assign glow = '#4a7c59'
      assign notes_top = 'Bergamot · Pear'
      assign notes_heart = 'Rose · Oud'
      assign notes_base = 'Amber · Sandalwood'
      assign note_keys = 'oud|rose|amber|sandalwood'
      assign occ = 'office'
      assign lon = 4
      assign proj = 3
      assign rrp = '€85'
    when 'club-de-nuit-intense'
      assign fallback_asset = 'club-de-nuit-intense-1.jpg'
      assign gender = 'him'
      assign tag = 'sophisticate'
      assign badge = 'bestseller'
      assign glow = '#4a7c59'
      assign notes_top = 'Grapefruit · Birch'
      assign notes_heart = 'Jasmine · Apple'
      assign notes_base = 'Musk · Patchouli'
      assign note_keys = 'musk|woody'
      assign occ = 'office'
      assign lon = 4
      assign proj = 4
      assign rrp = '€45'
    when 'meydan'
      assign fallback_asset = 'meydan-4.jpg'
      assign gender = 'him'
      assign tag = 'connoisseur'
      assign badge = 'new'
      assign glow = '#8a3060'
      assign notes_top = 'Saffron · Cardamom'
      assign notes_heart = 'Oud · Leather'
      assign notes_base = 'Amber · Sandalwood'
      assign note_keys = 'oud|amber|sandalwood'
      assign occ = 'evening'
      assign lon = 5
      assign proj = 5
      assign rrp = '€135'
    when 'rose-01'
      assign fallback_asset = 'rose-01-1.jpg'
      assign gender = 'her'
      assign tag = 'connoisseur'
      assign glow = '#8a3060'
      assign notes_top = 'Bergamot · Pink Pepper'
      assign notes_heart = 'Rose · Oud'
      assign notes_base = 'Musk · Amber'
      assign note_keys = 'oud|rose|musk|amber'
      assign occ = 'evening'
      assign lon = 4
      assign proj = 3
      assign rrp = '€90'
    when 'kismet-angel'
      assign fallback_asset = 'kismet-angel-1.jpg'
      assign gender = 'her'
      assign tag = 'gourmand'
      assign badge = 'new'
      assign glow = '#c87941'
      assign notes_top = 'Red Fruits · Watermelon'
      assign notes_heart = 'Jasmine · Peony'
      assign notes_base = 'Vanilla · Musk'
      assign note_keys = 'vanilla|musk'
      assign occ = 'weekend'
      assign lon = 3
      assign proj = 3
      assign rrp = '€28'
    when 'asad'
      assign fallback_asset = 'asad-1.jpg'
      assign gender = 'him'
      assign tag = 'sophisticate'
      assign badge = 'new'
      assign glow = '#4a7c59'
      assign notes_top = 'Bergamot · Citrus'
      assign notes_heart = 'Cedar · Spice'
      assign notes_base = 'Amber · Musk'
      assign note_keys = 'amber|musk|woody'
      assign occ = 'office'
      assign lon = 4
      assign proj = 4
      assign rrp = '€28'
    when 'royal-bleu'
      assign fallback_asset = 'royal-bleu-1.jpg'
      assign gender = 'him'
      assign tag = 'sophisticate'
      assign glow = '#4a7c59'
      assign notes_top = 'Lemon · Bergamot'
      assign notes_heart = 'Vetiver · Iris'
      assign notes_base = 'Cedar · Musk'
      assign note_keys = 'musk|woody'
      assign occ = 'everyday'
      assign lon = 3
      assign proj = 2
      assign rrp = '€75'
    when 'melodie'
      assign fallback_asset = 'melodie-1.jpg'
      assign gender = 'her'
      assign tag = 'gourmand'
      assign glow = '#c87941'
      assign notes_top = 'Raspberry · Saffron'
      assign notes_heart = 'Rose · Orange Blossom'
      assign notes_base = 'Vanilla · Praline'
      assign note_keys = 'rose|vanilla'
      assign occ = 'datenight'
      assign lon = 4
      assign proj = 3
      assign rrp = '€65'
    when 'turath'
      assign fallback_asset = 'turath-4.jpg'
      assign gender = 'unisex'
      assign tag = 'connoisseur'
      assign glow = '#8a3060'
      assign notes_top = 'Saffron · Oud'
      assign notes_heart = 'Amber · Rose'
      assign notes_base = 'Sandalwood · Musk'
      assign note_keys = 'oud|amber|rose|sandalwood|musk'
      assign occ = 'evening'
      assign lon = 5
      assign proj = 4
      assign rrp = '€135'
  endcase

  assign rrp = product.metafields.custom.rrp | default: ''
  if fallback_asset == blank
    capture fallback_asset_lookup
      render 'nur-product-fallback-asset', product: product
    endcapture
    assign fallback_asset = fallback_asset_lookup | strip
  endif

  assign force_bundle_image = false
  assign bundle_lookup = product.handle | append: ' ' | append: product.title | downcase
  if bundle_lookup contains 'arabian-introduction' or bundle_lookup contains 'arabian introduction' or bundle_lookup contains 'signature-masculine' or bundle_lookup contains 'signature masculine' or bundle_lookup contains 'oud-explorer' or bundle_lookup contains 'oud explorer'
    assign force_bundle_image = true
  endif
  capture curated_asset_flag
    render 'nur-product-use-assets', product: product
  endcapture
  assign curated_asset_flag = curated_asset_flag | strip
  assign use_asset_image = false
  if fallback_asset != blank
    if force_bundle_image or curated_asset_flag != blank
      assign use_asset_image = true
    endif
  endif

  if product.tags contains 'bestseller'
    assign badge = 'bestseller'
  elsif product.tags contains 'new'
    assign badge = 'new'
  endif

  assign variant_1ml = blank
  assign variant_2ml = blank
  assign variant_5ml = blank
  assign variant_10ml = blank
  for variant in product.variants
    assign variant_title = variant.title | downcase
    if variant_title contains '1ml'
      assign variant_1ml = variant
    elsif variant_title contains '2ml'
      assign variant_2ml = variant
    elsif variant_title contains '5ml'
      assign variant_5ml = variant
    elsif variant_title contains '10ml'
      assign variant_10ml = variant
    endif
  endfor

  assign stock = product.selected_or_first_available_variant.inventory_quantity | default: 0
-%}
{
  "slug": {{ product.handle | json }},
  "url": {{ product.url | json }},
  "name": {{ product.title | json }},
  "brand": {{ product.vendor | json }},
  "available": {{ product.available | json }},
  "gender": {{ gender | json }},
  "rating": null,
  "reviews": null,
  "compliment": null,
  "price": {{ product.price | money | json }},
  "priceMin": {{ product.price_min | divided_by: 100.0 | json }},
  "rrp": {{ rrp | json }},
  "tag": {{ tag | json }},
  "badge": {{ badge | json }},
  "glow": {{ glow | json }},
  "img": {% if use_asset_image %}{{ fallback_asset | asset_url | json }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 640 | json }}{% elsif fallback_asset != blank %}{{ fallback_asset | asset_url | json }}{% else %}{{ 'favicon-nur-logo.svg' | asset_url | json }}{% endif %},
  "notes": {
    "top": {{ notes_top | json }},
    "heart": {{ notes_heart | json }},
    "base": {{ notes_base | json }}
  },
  "noteKeys": [{%- assign note_key_list = note_keys | split: '|' -%}{%- for key in note_key_list -%}{{ key | strip | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  "sizes": [
    {%- if variant_1ml != blank -%}{"vol":"1ml","price":{{ variant_1ml.price | divided_by: 100.0 | json }},"pml":{{ variant_1ml.price | divided_by: 100.0 | json }},"label":"Sample"}{%- endif -%}
    {%- if variant_2ml != blank -%}{%- if variant_1ml != blank -%},{%- endif -%}{"vol":"2ml","price":{{ variant_2ml.price | divided_by: 100.0 | json }},"pml":{{ variant_2ml.price | divided_by: 200.0 | json }},"label":"Tester"}{%- endif -%}
    {%- if variant_5ml != blank -%}{%- if variant_1ml != blank or variant_2ml != blank -%},{%- endif -%}{"vol":"5ml","price":{{ variant_5ml.price | divided_by: 100.0 | json }},"pml":{{ variant_5ml.price | divided_by: 500.0 | json }},"label":"Decant","popular":true}{%- endif -%}
    {%- if variant_10ml != blank -%}{%- if variant_1ml != blank or variant_2ml != blank or variant_5ml != blank -%},{%- endif -%}{"vol":"10ml","price":{{ variant_10ml.price | divided_by: 100.0 | json }},"pml":{{ variant_10ml.price | divided_by: 1000.0 | json }},"label":"Full Try"}{%- endif -%}
  ],
  "variants": {
    {%- assign wrote_variant = false -%}
    {%- if variant_1ml != blank -%}"1ml":{{ variant_1ml.id | json }}{%- assign wrote_variant = true -%}{%- endif -%}
    {%- if variant_2ml != blank -%}{%- if wrote_variant -%},{%- endif -%}"2ml":{{ variant_2ml.id | json }}{%- assign wrote_variant = true -%}{%- endif -%}
    {%- if variant_5ml != blank -%}{%- if wrote_variant -%},{%- endif -%}"5ml":{{ variant_5ml.id | json }}{%- assign wrote_variant = true -%}{%- endif -%}
    {%- if variant_10ml != blank -%}{%- if wrote_variant -%},{%- endif -%}"10ml":{{ variant_10ml.id | json }}{%- endif -%}
  },
  "stock": {{ stock | json }},
  "occ": {{ occ | json }},
  "lon": {{ lon | json }},
  "proj": {{ proj | json }},
  "viewing": 0
}
