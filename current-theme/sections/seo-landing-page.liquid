          <a href="{{ routes.collections_url }}/musk-perfumes">Musk perfumes</a>
        </div>
      {%- else -%}
        <div class="seo-grid">
          <article>
            <h2>{% if nur_de %}Arabische Duftproben entdecken{% else %}Explore Arabian fragrance samples{% endif %}</h2>
            <p>{{ page.content | default: landing_desc }}</p>
          </article>
        </div>
    {%- endcase -%}
	  </div>
	  <div class="seo-faq" aria-label="Frequently asked questions">
	    <h2>{% if nur_de %}Häufig gestellte Fragen{% else %}Frequently Asked Questions{% endif %}</h2>
	    <details open>
	      <summary>{{ faq_q1 }}</summary>
	      <p>{{ faq_a1 }}</p>
	    </details>
	    <details>
	      <summary>{{ faq_q2 }}</summary>
	      <p>{{ faq_a2 }}</p>
	    </details>
	    <details>
	      <summary>{{ faq_q3 }}</summary>
	      <p>{{ faq_a3 }}</p>
	    </details>
	  </div>
	</section>

{% stylesheet %}
.seo-landing{background:var(--dark);color:var(--cream);min-height:70vh}
.seo-landing-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,420px);gap:4rem;align-items:center;max-width:1180px;margin:0 auto;padding:9rem 2rem 4rem}
.seo-kicker{display:block;font-family:var(--ral);font-size:.62rem;letter-spacing:.34em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem}
.seo-landing h1{font-family:var(--serif);font-size:clamp(2.6rem,6vw,5rem);font-weight:300;line-height:1.02;margin:0 0 1.4rem}
.seo-landing p{font-family:var(--ral);font-size:.95rem;line-height:1.9;color:rgba(245,240,232,.68);max-width:680px}
.seo-actions{display:flex;gap:.9rem;flex-wrap:wrap;margin-top:2rem}
.seo-primary,.seo-secondary,.seo-card-row a{font-family:var(--ral);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none;transition:all .22s}
.seo-primary{background:var(--gold);color:var(--dark);padding:1rem 1.35rem}
.seo-secondary{border:1px solid rgba(201,168,76,.35);color:var(--gold);padding:1rem 1.35rem}
.seo-primary:hover,.seo-secondary:hover{transform:translateY(-2px)}
.seo-landing-media{border:1px solid rgba(201,168,76,.16);background:rgba(255,255,255,.025);aspect-ratio:1;display:flex;align-items:center;justify-content:center;overflow:hidden}
.seo-landing-media img{width:100%;height:100%;object-fit:contain;padding:1.3rem;filter:drop-shadow(0 18px 44px rgba(0,0,0,.48))}
.seo-content{max-width:1120px;margin:0 auto;padding:2rem 2rem 7rem}
.seo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}
.seo-grid article{border:1px solid rgba(201,168,76,.12);background:rgba(255,255,255,.02);padding:2rem}
.seo-grid h2{font-family:var(--serif);font-size:1.8rem;font-weight:300;margin:0 0 .8rem;color:var(--cream)}
.seo-grid a{color:var(--gold)}
.seo-card-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem;margin-top:1rem}
	.seo-card-row a{border:1px solid rgba(201,168,76,.2);color:var(--gold);padding:1rem;min-height:74px;display:flex;align-items:center}
	.seo-card-row a:hover{background:rgba(201,168,76,.08);border-color:rgba(201,168,76,.45)}
	.seo-faq{max-width:900px;margin:3rem auto 0;border-top:1px solid rgba(201,168,76,.16)}
	.seo-faq h2{font-family:var(--serif);font-size:2rem;font-weight:300;margin:2rem 0 1rem;color:var(--cream)}
	.seo-faq details{border-bottom:1px solid rgba(201,168,76,.12);padding:1rem 0}
	.seo-faq summary{cursor:pointer;font-family:var(--ral);font-size:.95rem;color:var(--cream)}
	.seo-faq summary:focus-visible{outline:2px solid var(--gold);outline-offset:4px}
	.seo-faq p{margin:.8rem 0 0;max-width:760px}
	@media(max-width:860px){.seo-landing-hero,.seo-grid,.seo-card-row{grid-template-columns:1fr}.seo-landing-hero{padding-top:7rem;gap:2rem}.seo-landing-media{max-width:420px}.seo-actions{flex-direction:column}.seo-primary,.seo-secondary{text-align:center}}
{% endstylesheet %}

