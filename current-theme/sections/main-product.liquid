{%- liquid
  assign gift_packaging_product = all_products['luxury-gift-packaging-handwritten-card']
  assign gift_packaging_variant = gift_packaging_product.selected_or_first_available_variant
-%}

<!-- JAVASCRIPT -->
<script>
/* ─── Core state ────────────────────────────────────────────────── */
var NUR_DE = {{ nur_de | json }};
var _selectedVariantId = {{ preferred_variant.id }};
var _selectedPrice     = {{ preferred_variant.price }};
window.NUR_GIFT_PACKAGING_VARIANT_ID = {% if gift_packaging_variant != blank %}{{ gift_packaging_variant.id | json }}{% else %}58155455054149{% endif %};
window.NUR_GIFT_PACKAGING_AVAILABLE = {% if gift_packaging_variant != blank %}{{ gift_packaging_variant.available | json }}{% else %}true{% endif %};
window.NUR_CURRENT_PRODUCT_TITLE = {{ product.title | json }};
var gallery = [
  {%- if force_bundle_image and fallback_primary_asset != blank -%}
    '{{ fallback_primary_asset | asset_url }}'
  {%- elsif product.images.size > 0 and use_fallback_gallery == false -%}
    {%- for image in product.images -%}'{{ image | image_url: width: 1200 }}'{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  {%- elsif fallback_gallery_names != blank -%}
    {%- for fallback_asset in fallback_gallery -%}'{{ fallback_asset | asset_url }}'{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  {%- endif -%}
];
var _galIdx = 0;

/* ─── Asset fallback: probe CDN for product images ──────────────── */
(function(){
  if (gallery.length || !window.NUR_IMG) return;
  var h    = '{{ product.handle }}';
  var base = window.NUR_IMG;
  var candidates = [h+'.jpg', h+'-1.jpg', h+'-2.jpg', h+'-3.jpg',
                    h+'-4.jpg', h+'-5.jpg', h+'-6.jpg', h+'-7.jpg', h+'-8.jpg']
                    .map(function(n){ return base + n; });
  var loaded = [], pending = candidates.length;
  candidates.forEach(function(src, i){
    var img = new Image();
    img.onload  = function(){ loaded.push({src:src, i:i}); check(); };
    img.onerror = function(){ check(); };
    img.src = src;
  });
  function check(){
    if (--pending > 0) return;
    loaded.sort(function(a,b){ return a.i - b.i; });
    gallery = loaded.map(function(x){ return x.src; });
    if (!gallery.length) return;
    var mainImg = document.getElementById('mainImg');
    if (mainImg){ mainImg.src = gallery[0]; mainImg.style.display = ''; }
    var ctr = document.getElementById('imgCounter');
    if (ctr) ctr.textContent = '1 / ' + gallery.length;
    var strip = document.getElementById('thumbStrip');
    if (strip){
      strip.innerHTML = '';
      gallery.forEach(function(src, i){
        var d = document.createElement('div');
        d.className = 'thumb-item' + (i === 0 ? ' active' : '');
        d.style.backgroundImage = 'url(' + src + ')';
        d.onclick = (function(s, idx){ return function(){ setMain(d, s, idx); }; })(src, i);
        strip.appendChild(d);
      });
    }
    var lbStrip = document.getElementById('lbThumbs');
    if (lbStrip){
      lbStrip.innerHTML = '';
      gallery.forEach(function(src, i){
        var d = document.createElement('div');
        d.className = 'lb-thumb' + (i === 0 ? ' active' : '');
        d.style.backgroundImage = 'url(' + src + ')';
        d.onclick = function(){ setLBImage(i, true); };
        lbStrip.appendChild(d);
      });
    }
    var sImg = document.getElementById('stickyImg');
    if (sImg) sImg.src = gallery[0];
  }
})();

/* ─── Gallery helpers ───────────────────────────────────────────── */
function setMain(thumb, src, idx) {
  var img = document.getElementById('mainImg');
  if (img){ img.classList.add('fading'); setTimeout(function(){ img.src = src; img.classList.remove('fading'); }, 180); }
  document.querySelectorAll('.thumb-item').forEach(function(t){ t.classList.remove('active'); });
  if (thumb) thumb.classList.add('active');
  _galIdx = (idx !== undefined) ? idx : gallery.indexOf(src);
  var ctr = document.getElementById('imgCounter');
  if (ctr) ctr.textContent = (_galIdx + 1) + ' / ' + (gallery.length || 1);
}

function stepImg(dir) {
  if (!gallery.length) return;
  _galIdx = (_galIdx + dir + gallery.length) % gallery.length;
  var thumbs = document.querySelectorAll('.thumb-item');
  setMain(thumbs[_galIdx] || null, gallery[_galIdx], _galIdx);
}

/* ─── Full Lightbox ─────────────────────────────────────────────── */
var lbCur = 0, lbScale = 1, lbDragging = false;
var lbDragStart = {x:0,y:0}, lbTranslate = {x:0,y:0}, lbLastTranslate = {x:0,y:0};
var lbTouchStartX = null, lbTouchStartY = null;

function openLB(idx) {
  lbCur = (idx !== undefined) ? idx : _galIdx;
  lbScale = 1; lbTranslate = {x:0,y:0}; lbLastTranslate = {x:0,y:0};
  buildLBThumbs();
  setLBImage(lbCur, false);
  document.getElementById('lb').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLB() {
  document.getElementById('lb').classList.remove('open');
  document.body.style.overflow = '';
  resetZoom();
}
function lbBgClick(e) {
  if (e.target.id === 'lb' || e.target.id === 'lbMain') closeLB();
}
function buildLBThumbs() {
  var bar = document.getElementById('lbThumbs');
  if (!bar) return;
  bar.innerHTML = gallery.map(function(src, i) {
    return '<div class="lb-thumb' + (i===lbCur?' active':'') +
      '" style="background-image:url(\'' + src + '\')" onclick="setLBImage(' + i + ',true)"></div>';
  }).join('');
}
function setLBImage(idx, animate) {
  lbCur = idx;
  var img = document.getElementById('lbImg');
  if (!img) return;
  if (animate) img.classList.add('fading');
  setTimeout(function(){
    img.src = gallery[lbCur];
    if (animate) img.classList.remove('fading');
    resetZoom();
  }, animate ? 160 : 0);
  var ctr = document.getElementById('lbCounter');
  if (ctr) ctr.textContent = (lbCur+1) + ' / ' + gallery.length;
  document.querySelectorAll('.lb-thumb').forEach(function(t,i){ t.classList.toggle('active', i===lbCur); });
  var el = document.querySelectorAll('.lb-thumb')[lbCur];
  if (el) el.scrollIntoView({inline:'center', behavior:'smooth'});
}
function lbStep(dir) {
  setLBImage((lbCur + dir + gallery.length) % gallery.length, true);
}
function resetZoom() {
  lbScale = 1; lbTranslate = {x:0,y:0}; lbLastTranslate = {x:0,y:0};
  applyLBTransform();
  var img = document.getElementById('lbImg');
  if (img){ img.classList.remove('zoomed','dragging'); img.style.cursor = ''; }
  var zBtn = document.getElementById('lbZoomBtn');
  if (zBtn) zBtn.innerHTML = '&#x2295;';
  showZoomLevel();
}
function toggleZoom() {
  if (lbScale === 1){ lbScale = 2.5; } else { resetZoom(); return; }
  applyLBTransform();
  var img = document.getElementById('lbImg');
  if (img){ img.classList.add('zoomed'); img.style.cursor = ''; }
  var zBtn = document.getElementById('lbZoomBtn');
  if (zBtn) zBtn.innerHTML = '&#x2296;';
  showZoomLevel();
}
function applyLBTransform() {
  var img = document.getElementById('lbImg');
  if (img) img.style.transform = 'translate(' + lbTranslate.x + 'px,' + lbTranslate.y + 'px) scale(' + lbScale + ')';
  showZoomLevel();
}
function showZoomLevel() {
  var el = document.getElementById('lbZoomLevel');
  if (!el) return;
  el.textContent = Math.round(lbScale*100) + '%';
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(function(){ el.classList.remove('show'); }, 1400);
}

// Click to zoom/unzoom
document.getElementById('lbImg').addEventListener('click', function(e){
  if (lbDragging) return;
  if (lbScale === 1) toggleZoom(); else resetZoom();
});

// Drag to pan
document.getElementById('lbImg').addEventListener('mousedown', function(e){
  if (lbScale === 1) return;
  e.preventDefault();
  lbDragging = false;
  lbDragStart = {x: e.clientX - lbLastTranslate.x, y: e.clientY - lbLastTranslate.y};
  var img = document.getElementById('lbImg');
  if (img) img.classList.add('dragging');
  function onMove(e){
    lbDragging = true;
    lbTranslate = {x: e.clientX - lbDragStart.x, y: e.clientY - lbDragStart.y};
    applyLBTransform();
  }
  function onUp(){
    lbLastTranslate = {x: lbTranslate.x, y: lbTranslate.y};
    var img = document.getElementById('lbImg');
    if (img) img.classList.remove('dragging');
    setTimeout(function(){ lbDragging = false; }, 50);
    window.removeEventListener('mousemove', onMove);
    window.removeEventListener('mouseup', onUp);
  }
  window.addEventListener('mousemove', onMove);
  window.addEventListener('mouseup', onUp);
});

// Scroll-wheel zoom
document.getElementById('lbMain').addEventListener('wheel', function(e){
  e.preventDefault();
  lbScale = Math.max(1, Math.min(4, lbScale + (e.deltaY < 0 ? 0.35 : -0.35)));
  if (lbScale <= 1){ lbScale = 1; lbTranslate = {x:0,y:0}; lbLastTranslate = {x:0,y:0}; }
  var img = document.getElementById('lbImg');
  if (img){ img.classList.toggle('zoomed', lbScale > 1); img.style.cursor = ''; }
  var zBtn = document.getElementById('lbZoomBtn');
  if (zBtn) zBtn.innerHTML = lbScale > 1 ? '&#x2296;' : '&#x2295;';
  applyLBTransform();
}, {passive:false});

// Touch swipe
document.getElementById('lb').addEventListener('touchstart', function(e){
  lbTouchStartX = e.touches[0].clientX;
  lbTouchStartY = e.touches[0].clientY;
}, {passive:true});
document.getElementById('lb').addEventListener('touchend', function(e){
  if (lbTouchStartX === null) return;
  var dx = e.changedTouches[0].clientX - lbTouchStartX;
  var dy = e.changedTouches[0].clientY - lbTouchStartY;
  if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) lbStep(dx < 0 ? 1 : -1);
  lbTouchStartX = null; lbTouchStartY = null;
}, {passive:true});

// Keyboard navigation
document.addEventListener('keydown', function(e){
  if (!document.getElementById('lb').classList.contains('open')) return;
  if (e.key === 'Escape') closeLB();
  else if (e.key === 'ArrowRight') lbStep(1);
  else if (e.key === 'ArrowLeft')  lbStep(-1);
  else if (e.key === '+' || e.key === '=') toggleZoom();
  else if (e.key === '-') resetZoom();
});

// Hover-zoom on main image
(function(){
  var wrap = document.getElementById('mainWrap');
  var img  = document.getElementById('mainImg');
  if (!wrap || !img) return;
  wrap.addEventListener('mousemove', function(e){
    var r = wrap.getBoundingClientRect();
    img.style.transformOrigin = ((e.clientX-r.left)/r.width*100).toFixed(1)+'% '+((e.clientY-r.top)/r.height*100).toFixed(1)+'%';
  });
  wrap.addEventListener('mouseleave', function(){ img.style.transformOrigin = 'center center'; });
})();

/* ─── Variant selector ──────────────────────────────────────────── */
var SPRAY_SENTENCES = NUR_DE ? {
  '1ml':  '1 ml — Tupf-Fläschchen · kein Spray · aufs Handgelenk',
  '2ml':  '2 ml ≈ 25–35 Sprühstöße — perfekte Probengröße',
  '5ml':  '5 ml ≈ 60–80 Sprühstöße — testen, bevor du dich festlegst',
  '10ml': '10 ml ≈ 120–160 Sprühstöße — dein neuer Signature-Duft'
} : {
  '1ml':  '1 ml — dabber vial · no spray · apply to wrist',
  '2ml':  '2 ml ≈ 25–35 sprays — perfect sample size',
  '5ml':  '5 ml ≈ 60–80 sprays — try before you commit',
  '10ml': '10 ml ≈ 120–160 sprays — your new signature'
};

function selectVariant(tile) {
  document.querySelectorAll('.size-tile').forEach(function(t){ t.classList.remove('active'); });
  tile.classList.add('active');
  _selectedVariantId = tile.dataset.variantId;
  _selectedPrice     = parseInt(tile.dataset.priceRaw, 10);

  // Price display
  var priceEl = document.getElementById('pdpPrice');
  if (priceEl) priceEl.textContent = tile.dataset.price;

  // Size label
  var lblEl = document.getElementById('pdpSizeLabel');
  if (lblEl) lblEl.textContent = tile.dataset.title;

  // Per-ml price
  var pmlEl = document.getElementById('pricePerMl');
  if (pmlEl) pmlEl.textContent = tile.dataset.pml + (NUR_DE ? ' pro ml' : ' per ml');

  // Spray sentence (lives inside .benefits as a <li>)
  var ss = document.getElementById('spraySentence');
  if (ss) ss.innerHTML = SPRAY_SENTENCES[tile.dataset.size] || tile.dataset.title;

  // Klarna (hide if price < €10 = 1000 cents)
  var kl = document.getElementById('klarnaLine');
  var ka = document.getElementById('klarnaAmt');
  if (kl) {
    if (_selectedPrice < 1000) {
      kl.style.display = 'none';
    } else {
      kl.style.display = '';
      if (ka) ka.textContent = '€' + (Math.ceil(_selectedPrice / 3) / 100).toFixed(2);
    }
  }

  // Sticky bar price
  var sz = document.getElementById('stickySize');
  if (sz) sz.textContent = tile.dataset.title;
  var sp = document.getElementById('stickyPrice');
  if (sp) sp.textContent = tile.dataset.price;

  // Variant image switch (only when variant has a distinct image)
  if (tile.dataset.imgIndex !== undefined && tile.dataset.imgIndex !== '' && gallery.length > 0) {
    var imgIdx = parseInt(tile.dataset.imgIndex, 10);
    if (!isNaN(imgIdx) && gallery[imgIdx]) {
      var thumbEls = document.querySelectorAll('.thumb-item');
      setMain(thumbEls[imgIdx] || null, gallery[imgIdx], imgIdx);
    }
  }
}
document.addEventListener('DOMContentLoaded', function() {
  var activeTile = document.querySelector('.size-tile.active');
  if (activeTile) selectVariant(activeTile);
});

/* ─── Add to Shopify Cart ────────────────────────────────────────── */
function addToShopifyCart() {
  var btn = document.getElementById('btnCart');
  if (btn) { btn.textContent = NUR_DE ? 'Wird hinzugefügt…' : 'Adding…'; btn.disabled = true; }

  var giftWrap = document.getElementById('giftWrap');
  var giftWrapChecked = !!(giftWrap && giftWrap.checked);
  var mainItem = { id: parseInt(_selectedVariantId, 10), quantity: 1 };
  var items = [mainItem];

  if (giftWrapChecked) {
    mainItem.properties = {
      'Gift packaging': 'Luxury gift packaging & handwritten card'
    };

    if (window.NUR_GIFT_PACKAGING_VARIANT_ID && window.NUR_GIFT_PACKAGING_AVAILABLE) {
      items.push({
        id: parseInt(window.NUR_GIFT_PACKAGING_VARIANT_ID, 10),
        quantity: 1,
        properties: {
          '_nur_addon': 'gift_packaging',
          'For': window.NUR_CURRENT_PRODUCT_TITLE || {{ product.title | json }}
        }
      });
    }
  }

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ items: items })
  })
  .then(function(r){
    if (!r.ok) {
      return r.json().then(function(data){
        throw new Error(data.description || data.message || 'Cart add failed');
      });
    }
    return r.json();
  })
  .then(function(){
    if (btn) {
      btn.textContent = NUR_DE ? '✓ Zum Warenkorb hinzugefügt' : '✓ Added to Cart';
      btn.style.background = '#4a7c59';
      setTimeout(function(){
        btn.textContent = NUR_DE ? 'Probe in den Warenkorb' : 'Add Sample to Cart';
        btn.style.background = '';
        btn.disabled = false;
      }, 2000);
    }
    // Update cart count
    return fetch('/cart.js');
  })
  .then(function(r){ return r.json(); })
  .then(function(c){
    var badges = document.querySelectorAll('.cart-badge, #cartBadge');
    badges.forEach(function(b){ b.textContent = c.item_count; });
    // Open Shopify cart drawer (theme.liquid function)
    if (typeof openCart === 'function') openCart();
  })
  .catch(function(err){
    console.error('Cart error:', err);
    if (btn) { btn.textContent = NUR_DE ? 'Fehler — bitte erneut' : 'Error — try again'; btn.disabled = false; }
  });
}

/* ─── Wishlist toggle ────────────────────────────────────────────── */
function toggleWishlistBtn(btn) {
  btn.classList.toggle('saved');
  var icon = btn.querySelector('.wl-icon');
  if (icon) icon.textContent = btn.classList.contains('saved') ? '♥' : '♡';
}

/* ─── Delivery countdown ─────────────────────────────────────────── */
(function(){
  function nextBizDay(d, n){
    var r = new Date(d);
    for (var i = 0; i < n;){ r.setDate(r.getDate()+1); var dw = r.getDay(); if (dw!==0&&dw!==6) i++; }
    return r;
  }
  var DAYS = NUR_DE ? ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'] : ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  function tick(){
    var now    = new Date();
    var cutoff = new Date(now); cutoff.setHours(14,0,0,0);
    var shipFrom  = (now >= cutoff) ? nextBizDay(now, 1) : now;
    var arrives   = nextBizDay(shipFrom, 3);
    var dayEl = document.getElementById('deliveryDay');
    if (dayEl) dayEl.textContent = DAYS[arrives.getDay()];
    var tmrEl = document.getElementById('orderTimer');
    if (tmrEl){
      if (now < cutoff){
        var diff = cutoff - now;
        var h = Math.floor(diff / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        tmrEl.textContent = h + 'h ' + String(m).padStart(2,'0') + 'm';
        setTimeout(tick, 60000);
      } else {
        tmrEl.textContent = NUR_DE ? 'morgen früh' : 'tomorrow morning';
      }
    }
  }
  tick();
})();

/* Live viewer count disabled until connected to real analytics data. */

/* ─── Sticky bar ─────────────────────────────────────────────────── */
(function(){
  var sBar    = document.getElementById('stickyBar');
  var mainBtn = document.querySelector('.btn-cart:not(.sticky-cta)');
  if (sBar && mainBtn){
    var io = new IntersectionObserver(function(entries){
      sBar.classList.toggle('visible', !entries[0].isIntersecting);
    }, {threshold: 0});
    io.observe(mainBtn);
  }
})();

