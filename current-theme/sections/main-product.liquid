{% render 'product-json-ld', product: product %}
{%- liquid
  assign nur_de = false
  if request.locale.iso_code == 'de'
    assign nur_de = true
  endif
  assign nur_root_url = routes.root_url | append: '/' | replace: '//', '/'
  capture fallback_primary_asset
    render 'nur-product-fallback-asset', product: product
  endcapture
  assign fallback_primary_asset = fallback_primary_asset | strip
  capture fallback_gallery_names
    render 'nur-product-fallback-gallery', product: product
  endcapture
  assign fallback_gallery_names = fallback_gallery_names | strip
  assign fallback_gallery = fallback_gallery_names | split: '|'
  assign force_bundle_image = false
  assign bundle_lookup = product.handle | append: ' ' | append: product.title | downcase
  if bundle_lookup contains 'arabian-introduction' or bundle_lookup contains 'arabian introduction' or bundle_lookup contains 'signature-masculine' or bundle_lookup contains 'signature masculine' or bundle_lookup contains 'oud-explorer' or bundle_lookup contains 'oud explorer'
    assign force_bundle_image = true
  endif
  capture curated_asset_flag
    render 'nur-product-use-assets', product: product
  endcapture
  assign curated_asset_flag = curated_asset_flag | strip
  assign use_fallback_gallery = false
  if curated_asset_flag != blank
    assign use_fallback_gallery = true
  endif
  if force_bundle_image and fallback_primary_asset != blank
    assign gallery_count = 1
  else
    if use_fallback_gallery
      assign gallery_count = fallback_gallery.size
    else
      assign gallery_count = product.images.size
    endif
    if gallery_count == 0
      assign gallery_count = 1
    endif
  endif

  assign preferred_variant = blank
  for variant in product.variants
    if variant.title contains '5ml'
      assign preferred_variant = variant
      break
    endif
  endfor
  if preferred_variant == blank
    assign preferred_variant = product.selected_or_first_available_variant
  endif

  assign product_short_description = product.metafields.custom.short_description | default: product.metafields.custom.scent_story | default: product.description | strip_html | strip
  assign product_poetic_line = product.metafields.custom.poetic_description | default: product_short_description
  assign product_top_notes = product.metafields.custom.top_notes
  assign product_heart_notes = product.metafields.custom.heart_notes
  assign product_base_notes = product.metafields.custom.base_notes
  assign product_profile = product.metafields.custom.profile | default: 'Warm Arabian fragrance'

  case product.handle
    when 'khamrah'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'Warm amber poured over spiced dates, soft vanilla and golden woods. Rich, sweet and enveloping without feeling loud.'
      assign product_top_notes = product_top_notes | default: 'Cinnamon · Nutmeg · Bergamot'
      assign product_heart_notes = product_heart_notes | default: 'Dates · Praline · Tuberose'
      assign product_base_notes = product_base_notes | default: 'Vanilla · Tonka · Amberwood · Myrrh'
      assign product_profile = product.metafields.custom.profile | default: 'Sweet amber gourmand'
    when 'asad'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'Dark spice, black amber and dry vanilla create a confident Arabian scent with a smoky, masculine edge.'
      assign product_top_notes = product_top_notes | default: 'Black Pepper · Pineapple · Tobacco'
      assign product_heart_notes = product_heart_notes | default: 'Coffee · Patchouli · Iris'
      assign product_base_notes = product_base_notes | default: 'Amber · Vanilla · Dry Woods'
      assign product_profile = product.metafields.custom.profile | default: 'Dark spicy amber'
    when 'club-de-nuit-intense'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'A crisp citrus opening settles into smoky woods and musk, built for clean confidence and everyday compliments.'
      assign product_top_notes = product_top_notes | default: 'Lemon · Blackcurrant · Apple'
      assign product_heart_notes = product_heart_notes | default: 'Birch · Jasmine · Rose'
      assign product_base_notes = product_base_notes | default: 'Musk · Ambergris · Vanilla · Patchouli'
      assign product_profile = product.metafields.custom.profile | default: 'Fresh smoky woods'
    when 'club-de-nuit-precieux'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'Bright bergamot and pepper over polished woods, amber and leather. Elegant, sharp and quietly luxurious.'
      assign product_top_notes = product_top_notes | default: 'Bergamot · Pepper · Citrus'
      assign product_heart_notes = product_heart_notes | default: 'Jasmine · Iris · Dry Woods'
      assign product_base_notes = product_base_notes | default: 'Amber · Leather · Musk'
      assign product_profile = product.metafields.custom.profile | default: 'Sophisticated woody amber'
    when 'dahaab-safi'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'A soft golden fragrance with creamy sweetness, gentle florals and a polished Arabian warmth.'
      assign product_top_notes = product_top_notes | default: 'Citrus · Sweet Fruits · Soft Spice'
      assign product_heart_notes = product_heart_notes | default: 'White Florals · Rose · Creamy Accord'
      assign product_base_notes = product_base_notes | default: 'Musk · Amber · Vanilla'
      assign product_profile = product.metafields.custom.profile | default: 'Soft golden sweetness'
    when 'meydan'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'Clean citrus, aromatic woods and a refined leather-green drydown inspired by Dubai elegance.'
      assign product_top_notes = product_top_notes | default: 'Bergamot · Grapefruit · Apple'
      assign product_heart_notes = product_heart_notes | default: 'Leather · Violet · Jasmine'
      assign product_base_notes = product_base_notes | default: 'Amber · Woods · Musk'
      assign product_profile = product.metafields.custom.profile | default: 'Fresh refined leather'
    when 'kismet-angel'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'Honey, cinnamon and amber melt into chocolatey vanilla warmth. A sweet gourmand made for cosy evenings.'
      assign product_top_notes = product_top_notes | default: 'Honey · Apricot · Vanilla'
      assign product_heart_notes = product_heart_notes | default: 'Cinnamon · Amber · Caramel'
      assign product_base_notes = product_base_notes | default: 'Chocolate · Tonka · Musk'
      assign product_profile = product.metafields.custom.profile | default: 'Sweet warm gourmand'
    when 'melodie'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'Turquoise freshness, soft florals and polished amber woods. Bright, smooth and easy to wear.'
      assign product_top_notes = product_top_notes | default: 'Mandarin · Pear · Fresh Citrus'
      assign product_heart_notes = product_heart_notes | default: 'Jasmine · Orange Blossom · Soft Florals'
      assign product_base_notes = product_base_notes | default: 'Amber · Musk · Woods'
      assign product_profile = product.metafields.custom.profile | default: 'Fresh floral amber'
    when 'rose-01'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'A luminous rose fragrance with juicy fruit, graceful florals and a soft musky trail.'
      assign product_top_notes = product_top_notes | default: 'Lychee · Bergamot · Pink Pepper'
      assign product_heart_notes = product_heart_notes | default: 'Rose · Peony · Nutmeg'
      assign product_base_notes = product_base_notes | default: 'Musk · Amber · Woods'
      assign product_profile = product.metafields.custom.profile | default: 'Fruity rose musk'
    when 'royal-bleu'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'A polished blue fragrance with aromatic freshness, smooth spice and a clean luxury drydown.'
      assign product_top_notes = product_top_notes | default: 'Citrus · Lavender · Fresh Spice'
      assign product_heart_notes = product_heart_notes | default: 'Geranium · Jasmine · Aromatic Woods'
      assign product_base_notes = product_base_notes | default: 'Amber · Musk · Sandalwood'
      assign product_profile = product.metafields.custom.profile | default: 'Fresh aromatic blue'
    when 'turath'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'Sparkling citrus and warm woods with a smooth amber finish. Clean, bright and quietly addictive.'
      assign product_top_notes = product_top_notes | default: 'Grapefruit · Mandarin · Citrus'
      assign product_heart_notes = product_heart_notes | default: 'Spice · Vetiver · Fresh Woods'
      assign product_base_notes = product_base_notes | default: 'Amber · Musk · Patchouli'
      assign product_profile = product.metafields.custom.profile | default: 'Citrus amber woods'
    when 'yulali'
      assign product_poetic_line = product.metafields.custom.poetic_description | default: 'Soft pink florals, delicate sweetness and polished musk. Elegant, feminine and luminous.'
      assign product_top_notes = product_top_notes | default: 'Citrus · Red Fruits · Fresh Florals'
      assign product_heart_notes = product_heart_notes | default: 'Rose · Jasmine · Lily'
      assign product_base_notes = product_base_notes | default: 'Musk · Amber · Soft Woods'
      assign product_profile = product.metafields.custom.profile | default: 'Soft floral musk'
  endcase

  if nur_de
    capture product_top_notes
      render 'nur-de-terms', s: product_top_notes
    endcapture
    capture product_heart_notes
      render 'nur-de-terms', s: product_heart_notes
    endcapture
    capture product_base_notes
      render 'nur-de-terms', s: product_base_notes
    endcapture
    capture product_profile
      render 'nur-de-terms', s: product_profile
    endcapture
    assign product_top_notes = product_top_notes | strip
    assign product_heart_notes = product_heart_notes | strip
    assign product_base_notes = product_base_notes | strip
    assign product_profile = product_profile | strip
    case product.handle
      when 'khamrah'
        assign product_poetic_line = 'Warmer Amber über gewürzten Datteln, weiche Vanille und goldene Hölzer. Reich, süß und umhüllend, ohne laut zu sein.'
      when 'asad'
        assign product_poetic_line = 'Dunkle Gewürze, schwarzer Amber und trockene Vanille ergeben einen selbstbewussten arabischen Duft mit rauchiger, maskuliner Kante.'
      when 'club-de-nuit-intense'
        assign product_poetic_line = 'Ein frischer Zitrus-Auftakt setzt sich in rauchige Hölzer und Moschus — gemacht für klare Souveränität und alltägliche Komplimente.'
      when 'club-de-nuit-precieux'
        assign product_poetic_line = 'Helle Bergamotte und Pfeffer über polierten Hölzern, Amber und Leder. Elegant, markant und leise luxuriös.'
      when 'dahaab-safi'
        assign product_poetic_line = 'Ein sanfter goldener Duft mit cremiger Süße, zarten Blüten und einer polierten arabischen Wärme.'
      when 'meydan'
        assign product_poetic_line = 'Klare Zitrus, aromatische Hölzer und ein raffinierter Leder-Grün-Nachklang, inspiriert von Dubais Eleganz.'
      when 'kismet-angel'
        assign product_poetic_line = 'Honig, Zimt und Amber verschmelzen zu schokoladiger Vanille-Wärme. Ein süßer Gourmand für gemütliche Abende.'
      when 'melodie'
        assign product_poetic_line = 'Türkisfrische, weiche Blüten und polierte Amberhölzer. Hell, geschmeidig und leicht zu tragen.'
      when 'rose-01'
        assign product_poetic_line = 'Ein leuchtender Rosenduft mit saftigen Früchten, anmutigen Blüten und einer sanften Moschus-Spur.'
      when 'royal-bleu'
        assign product_poetic_line = 'Ein polierter blauer Duft mit aromatischer Frische, geschmeidiger Würze und einem klaren Luxus-Nachklang.'
      when 'turath'
        assign product_poetic_line = 'Prickelnde Zitrus und warme Hölzer mit weichem Amber-Finish. Klar, hell und leise süchtig machend.'
      when 'yulali'
        assign product_poetic_line = 'Weiche rosa Blüten, zarte Süße und polierter Moschus. Elegant, feminin und leuchtend.'
    endcase
  endif
-%}

<!-- LIGHTBOX -->
<div class="lb-overlay" id="lb" onclick="lbBgClick(event)">
  <button class="lb-btn lb-close" onclick="closeLB()" aria-label="Close">&#x2715;</button>
  <div class="lb-counter" id="lbCounter"></div>
  <div class="lb-main" id="lbMain">
    <button class="lb-btn lb-prev" onclick="lbStep(-1)" aria-label="Previous">&#x2039;</button>
    <img id="lbImg" class="lb-img" src="{{ 'favicon-nur-logo.svg' | asset_url }}" alt="" draggable="false" width="1200" height="1200">
    <button class="lb-btn lb-next" onclick="lbStep(1)" aria-label="Next">&#x203a;</button>
    <button class="lb-btn lb-zoom-btn" id="lbZoomBtn" onclick="toggleZoom()" title="Zoom">&#x2295;</button>
    <div class="lb-zoom-level" id="lbZoomLevel"></div>
  </div>
  <div class="lb-thumbs" id="lbThumbs"></div>
</div>

<!-- BREADCRUMB -->
<div class="breadcrumb">
  <a href="{{ routes.root_url }}">NUR Fragrances</a> &nbsp;/&nbsp;
  <a href="{{ routes.all_products_collection_url }}">{% if nur_de %}Kollektion{% else %}Collection{% endif %}</a> &nbsp;/&nbsp;
  <span>{{ product.title }}</span>
</div>

<!-- PDP HERO -->
<section class="pdp-hero" aria-label="{{ product.title | escape }} product details">

  <!-- GALLERY -->
  <div class="gallery-outer">
    <div class="main-img-wrap" id="mainWrap" onclick="openLB(_galIdx)">
      {%- if force_bundle_image and fallback_primary_asset != blank -%}
      <img id="mainImg" class="main-img"
           src="{{ fallback_primary_asset | asset_url }}"
           alt="{{ product.title | escape }}"
           width="800"
           height="800">
      {%- elsif use_fallback_gallery and fallback_primary_asset != blank -%}
      <img id="mainImg" class="main-img"
           src="{{ fallback_primary_asset | asset_url }}"
           alt="{{ product.title | escape }}"
           width="800"
           height="800">
      {%- elsif product.featured_image -%}
      <img id="mainImg" class="main-img"
           src="{{ product.featured_image | image_url: width: 800 }}"
           srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                   {{ product.featured_image | image_url: width: 800 }} 800w,
                   {{ product.featured_image | image_url: width: 1200 }} 1200w"
           sizes="(max-width:600px) calc(100vw - 2rem),(max-width:1024px) 48vw,520px"
           width="{{ product.featured_image.width | default: 800 }}"
           height="{{ product.featured_image.height | default: 800 }}"
           alt="{{ product.featured_image.alt | default: product.title | escape }}">
      {%- elsif fallback_primary_asset != blank -%}
      <img id="mainImg" class="main-img"
           src="{{ fallback_primary_asset | asset_url }}"
           alt="{{ product.title | escape }}"
           width="800"
           height="800">
      {%- else -%}
      <img id="mainImg" class="main-img" src="{{ 'favicon-nur-logo.svg' | asset_url }}" alt="{{ product.title | escape }}" style="display:none" width="800" height="800">
      {%- endif -%}
      <button class="img-arrow prev" onclick="event.stopPropagation();stepImg(-1)" aria-label="Previous">&#x2039;</button>
      <button class="img-arrow next" onclick="event.stopPropagation();stepImg(1)" aria-label="Next">&#x203a;</button>
      <div class="img-counter" id="imgCounter">1 / {{ gallery_count }}</div>
      <div class="zoom-hint">&#x1F50D;</div>
    </div>
    <div class="thumb-strip" id="thumbStrip">
      {%- if force_bundle_image and fallback_primary_asset != blank -%}
      <div class="thumb-item active"
           onclick="setMain(this,'{{ fallback_primary_asset | asset_url }}',0)"
           style="background-image:url('{{ fallback_primary_asset | asset_url }}')"></div>
      {%- elsif product.images.size > 0 and use_fallback_gallery == false -%}
      {%- for image in product.images -%}
      <div class="thumb-item{%- if forloop.first %} active{%- endif -%}"
           onclick="setMain(this,'{{ image | image_url: width: 1200 }}',{{ forloop.index0 }})"
           style="background-image:url('{{ image | image_url: width: 160 }}')"></div>
      {%- endfor -%}
      {%- elsif fallback_gallery_names != blank -%}
      {%- for fallback_asset in fallback_gallery -%}
      <div class="thumb-item{%- if forloop.first %} active{%- endif -%}"
           onclick="setMain(this,'{{ fallback_asset | asset_url }}',{{ forloop.index0 }})"
           style="background-image:url('{{ fallback_asset | asset_url }}')"></div>
      {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <!-- PRODUCT INFO -->
  <div class="pdp-info">
    <div class="pdp-brand">{{ product.vendor }}</div>
    <h1 class="pdp-name">{{ product.title }} <span class="pdp-name-sub">{% if nur_de %}Echter Duft-Decant{% else %}Authentic Fragrance Decant{% endif %}</span></h1>
    <p class="pdp-hero-copy">{{ product_poetic_line | strip_html | truncate: 220 }}</p>

    <!-- SIZE SELECTOR -->
    <div class="size-selector">
      <div class="size-selector-label">{% if nur_de %}Größe wählen{% else %}Choose Size{% endif %}</div>
	      <div class="size-tiles">
	        {%- for variant in product.variants -%}
          {%- assign vol_label = '' -%}
          {%- assign note_label = '' -%}
          {%- assign show_badge = false -%}
          {%- assign size_key = '' -%}
          {%- if variant.title contains '1ml' -%}
            {%- assign vol_label = '1 ml' -%}
            {%- assign note_label = 'Try It' -%}{%- if nur_de %}{%- assign note_label = 'Zum Testen' -%}{%- endif -%}
            {%- assign size_key = '1ml' -%}
          {%- elsif variant.title contains '2ml' -%}
            {%- assign vol_label = '2 ml' -%}
            {%- assign note_label = 'Tester' -%}{%- if nur_de %}{%- assign note_label = 'Tester' -%}{%- endif -%}
            {%- assign size_key = '2ml' -%}
          {%- elsif variant.title contains '5ml' -%}
            {%- assign vol_label = '5 ml' -%}
            {%- assign note_label = 'Decant' -%}{%- if nur_de %}{%- assign note_label = 'Decant' -%}{%- endif -%}
            {%- assign show_badge = true -%}
            {%- assign size_key = '5ml' -%}
          {%- elsif variant.title contains '10ml' -%}
            {%- assign vol_label = '10 ml' -%}
            {%- assign note_label = 'Best value' -%}{%- if nur_de %}{%- assign note_label = 'Bester Preis' -%}{%- endif -%}
            {%- assign size_key = '10ml' -%}
          {%- else -%}
            {%- assign vol_label = variant.title -%}
            {%- assign note_label = '' -%}
            {%- assign size_key = variant.title -%}
          {%- endif -%}
          {%- assign pml_cents = variant.price -%}
          {%- if size_key == '1ml' -%}{%- assign pml_cents = variant.price -%}
          {%- elsif size_key == '2ml' -%}{%- assign pml_cents = variant.price | divided_by: 2 -%}
          {%- elsif size_key == '5ml' -%}{%- assign pml_cents = variant.price | divided_by: 5 -%}
          {%- elsif size_key == '10ml' -%}{%- assign pml_cents = variant.price | divided_by: 10 -%}
          {%- endif -%}
          {%- assign v_img_index = '' -%}
          {%- if variant.featured_image -%}
            {%- for img in product.images -%}
              {%- if img.id == variant.featured_image.id -%}
                {%- assign v_img_index = forloop.index0 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        <div class="size-tile{%- if variant.id == preferred_variant.id %} active{%- endif -%}"
             data-variant-id="{{ variant.id }}"
             data-price="{{ variant.price | money }}"
             data-price-raw="{{ variant.price }}"
             data-title="{{ variant.title }}"
             data-size="{{ size_key }}"
             data-pml="{{ pml_cents | money }}"
             data-available="{{ variant.available }}"
             {%- if v_img_index != '' -%}data-img-index="{{ v_img_index }}"{%- endif -%}
             onclick="selectVariant(this)">
          {%- if show_badge -%}<span class="st-badge">{% if nur_de %}Beliebt{% else %}Popular{% endif %}</span>{%- endif -%}
          <span class="st-vol">{{ vol_label }}</span>
          <span class="st-price">{{ variant.price | money }}</span>
          {%- if note_label != '' -%}<span class="st-note">{{ note_label }}</span>{%- endif -%}
	        </div>
	        {%- endfor -%}
	      </div>
	      <div class="sample-guide" aria-label="Sample size guide">
	        <span><strong>1ml</strong> {% if nur_de %}erster Hauttest{% else %}first skin test{% endif %}</span>
	        <span><strong>2ml</strong> {% if nur_de %}Test für eine Woche{% else %}week-long tester{% endif %}</span>
	        <span><strong>5ml</strong> {% if nur_de %}beliebter Decant{% else %}popular decant{% endif %}</span>
	        <span><strong>10ml</strong> {% if nur_de %}bester Preis{% else %}best value{% endif %}</span>
	      </div>
	    </div>

    <!-- STOCK METER -->
    <div class="stock-meter">
      <div class="sm-top">
        <span class="stock-dot"></span>
        {%- if product.available -%}
          {% if nur_de %}Auf Lager &middot; <strong>auf Bestellung abgefüllt</strong> aus Originalflaschen{% else %}In stock &middot; <strong>filled to order</strong> from original bottles{% endif %}
        {%- else -%}
          {% if nur_de %}Bald wieder verfügbar{% else %}Restocking soon{% endif %}
        {%- endif -%}
      </div>
      <div class="sm-bar"><div class="sm-fill" style="width:{% if product.available %}100{% else %}0{% endif %}%"></div></div>
    </div>

    <!-- PRICE BOX -->
    <div class="price-box">
      <div class="price-row">
        <div class="pdp-price" id="pdpPrice">{{ preferred_variant.price | money }}</div>
        <div class="price-per-ml" id="pricePerMl"></div>
      </div>
      {%- if product.metafields.custom.rrp != blank -%}
      <div class="rrp-anchor">
        {% if nur_de %}Ganze Flasche {% else %}Full bottle {% endif %}<span class="rrp-line-thru">{{ product.metafields.custom.rrp }}</span>
        {%- if product.metafields.custom.rrp_save != blank -%}
        &middot; <span class="rrp-save-badge">{% if nur_de %}Spare{% else %}Save{% endif %} {{ product.metafields.custom.rrp_save }}</span> {% if nur_de %}ggü. Boutique-Preis{% else %}vs boutique price{% endif %}
        {%- endif -%}
      </div>
      {%- endif -%}
      <div class="pdp-size" id="pdpSizeLabel">{{ preferred_variant.title }} Decant &middot; {% if nur_de %}von Hand abgefüllt{% else %}hand-filled{% endif %}</div>
      <ul class="benefits">
        <li>{% if nur_de %}Echter Duft, auf Bestellung von Hand abgefüllt{% else %}Authentic fragrance, hand-decanted to order{% endif %}</li>
        <li id="spraySentence">{% if nur_de %}5&#x202F;ml &#x2248; 60&ndash;80&#x202F;Sprühstöße &mdash; testen, bevor du dich festlegst{% else %}5&#x202F;ml &#x2248; 60&ndash;80&#x202F;sprays &mdash; try before you commit{% endif %}</li>
        <li>{% if nur_de %}Versand mit Tracking &middot; 3&ndash;5 Tage in Europa{% else %}Tracked shipping &middot; 3&ndash;5 days across Europe{% endif %}</li>
        <li>{% if nur_de %}30 Tage Zufriedenheitsgarantie{% else %}30-day satisfaction guarantee{% endif %}</li>
        <li>{% if nur_de %}Gratis 1-ml-Probe bei jeder Bestellung{% else %}Free 1 ml sample included with every order{% endif %}</li>
      </ul>
      <div class="gift-addon">
        <label>
          <span class="gift-icon">&#x1F381;</span>
          <input type="checkbox" id="giftWrap">
          <span>{% if nur_de %}Luxus-Geschenkverpackung &amp; handgeschriebene Karte &mdash; <strong>+&#x20AC;2,90</strong>{% else %}Add luxury gift packaging &amp; handwritten card &mdash; <strong>+&#x20AC;2.90</strong>{% endif %}</span>
        </label>
      </div>
      {%- liquid
        assign best_for_chips = 'First-timer|Cold weather'
        case product.handle
          when 'club-de-nuit-intense', 'asad', 'royal-bleu', 'yulali'
            assign best_for_chips = 'Office|First-timer'
          when 'khamrah', 'dahaab-safi', 'kismet-angel', 'melodie'
            assign best_for_chips = 'Date night|Cold weather|First-timer'
          when 'meydan', 'club-de-nuit-precieux', 'rose-01', 'turath'
            assign best_for_chips = 'Date night|Cold weather|Bold oud'
        endcase
        assign best_for_list = best_for_chips | split: '|'
      -%}
      <div class="pdp-best-for" aria-label="Best for">
        <span class="pdp-best-for-label">{% if nur_de %}Ideal für{% else %}Best for{% endif %}</span>
        {%- for chip in best_for_list -%}
          <span class="pdp-best-chip">{{ chip }}</span>
        {%- endfor -%}
      </div>
