/* ─── FBT — total & add all to cart ─────────────────────────────── */
function updateFBTTotal() {
  var total = 0;
  document.querySelectorAll('.fbt-item input[type=checkbox]').forEach(function(cb) {
    if (cb.checked) total += parseFloat(cb.dataset.price || 0);
  });
  var el = document.getElementById('fbtTotalPrice');
  if (el) el.textContent = '€' + total.toFixed(2).replace('.', ',');
}

function addFBTToCart() {
  var btn = document.getElementById('fbtAddBtn');
  var items = [];
  document.querySelectorAll('.fbt-item input[type=checkbox]').forEach(function(cb) {
    if (cb.checked && cb.dataset.variantId) {
      items.push({ id: parseInt(cb.dataset.variantId, 10), quantity: 1 });
    }
  });
  if (!items.length) return;
  if (btn) { btn.textContent = NUR_DE ? 'Wird hinzugefügt…' : 'Adding…'; btn.disabled = true; }
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ items: items })
  })
  .then(function(r) { return r.json(); })
  .then(function() {
    if (btn) {
      btn.textContent = NUR_DE ? '✓ Zum Warenkorb hinzugefügt!' : '✓ Added to Cart!';
      btn.style.background = 'rgba(74,180,130,.15)';
      btn.style.borderColor = '#4ab482';
      btn.style.color = '#4ab482';
      setTimeout(function() {
        btn.textContent = NUR_DE ? 'Alle in den Warenkorb →' : 'Add All to Cart →';
        btn.style.background = ''; btn.style.borderColor = ''; btn.style.color = '';
        btn.disabled = false;
      }, 2500);
    }
    return fetch('/cart.js');
  })
  .then(function(r) { return r.json(); })
  .then(function(c) {
    document.querySelectorAll('.cart-badge, #cartBadge').forEach(function(b) {
      b.textContent = c.item_count;
    });
    if (typeof openCart === 'function') openCart();
  })
  .catch(function() {
    if (btn) { btn.textContent = NUR_DE ? 'Fehler — bitte erneut' : 'Error — try again'; btn.disabled = false; }
  });
}

/* ─── Cross-sell CDN image fallback ─────────────────────────── */
(function(){
  if (!window.NUR_IMG) return;
  document.querySelectorAll('img[data-cdn-fallback]').forEach(function(img){
    var key = img.dataset.cdnFallback; // e.g. "khamrah-1"
    var src = window.NUR_IMG + key + '.jpg';
    var probe = new Image();
    probe.onload  = function(){ img.src = src; img.style.display = ''; };
    probe.onerror = function(){ img.style.display = 'none'; };
    probe.src = src;
  });
})();
